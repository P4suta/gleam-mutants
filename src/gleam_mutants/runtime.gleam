import gleam/result
import gleam/string
import gleam_mutants/core/path
import simplifile

pub type RuntimeModule {
  RuntimeModule(module_name: String, tag: String)
}

pub fn name(runtime: RuntimeModule) -> String {
  runtime.module_name
}

pub fn generate(
  snapshot_root: String,
  workspace_digest: String,
) -> Result(RuntimeModule, String) {
  let tag = string.lowercase(string.slice(workspace_digest, 0, 12))
  let module_name = "gleam_mutants_runtime_" <> tag
  let ffi_name = module_name <> "_ffi"
  let directory = path.join(snapshot_root, "src")
  use _ <- result.try(
    simplifile.create_directory_all(directory)
    |> result.map_error(simplifile.describe_error),
  )
  let gleam_path = path.join(directory, module_name <> ".gleam")
  let js_path = path.join(directory, ffi_name <> ".mjs")
  let erlang_path = path.join(directory, ffi_name <> ".erl")
  let gleam_source =
    "// Generated by gleam-mutants. This file exists only in a disposable snapshot.\n"
    <> "@external(erlang, \""
    <> ffi_name
    <> "\", \"active\")\n"
    <> "@external(javascript, \"./"
    <> ffi_name
    <> ".mjs\", \"active\")\n"
    <> "fn active() -> String\n\n"
    <> "@external(erlang, \""
    <> ffi_name
    <> "\", \"record\")\n"
    <> "@external(javascript, \"./"
    <> ffi_name
    <> ".mjs\", \"record\")\n"
    <> "fn record(id: String) -> Nil\n\n"
    <> "@external(erlang, \""
    <> ffi_name
    <> "\", \"observe\")\n"
    <> "@external(javascript, \"./"
    <> ffi_name
    <> ".mjs\", \"observe\")\n"
    <> "fn observe(id: String, differed: Bool) -> Nil\n\n"
    <> "pub fn select(id: String, original: fn() -> a, replacement: fn() -> a) -> a {\n"
    <> "  case active() {\n"
    <> "    \"\" -> {\n"
    <> "      record(id)\n"
    <> "      original()\n"
    <> "    }\n"
    <> "    selected -> case selected == id { True -> replacement() False -> original() }\n"
    <> "  }\n"
    <> "}\n\n"
    // The same guard, for a mutant whose replacement the catalogue vouched may
    // be evaluated beside the original. On the walk that has nothing mutated,
    // both are answered and the pair is reported; a mutant whose two answers
    // never part cannot be told apart by these tests at all.
    <> "pub fn compare(id: String, original: fn() -> a, replacement: fn() -> a) -> a {\n"
    <> "  case active() {\n"
    <> "    \"\" -> {\n"
    <> "      record(id)\n"
    <> "      let answer = original()\n"
    <> "      observe(id, answer != replacement())\n"
    <> "      answer\n"
    <> "    }\n"
    <> "    selected -> case selected == id { True -> replacement() False -> original() }\n"
    <> "  }\n"
    <> "}\n"
  let js_source =
    "// Generated by gleam-mutants.\n"
    <> "import fs from \"node:fs\";\n"
    // A run switches mutants by starting a process per mutant, and a probe
    // switches them between calls inside one. The environment answers the
    // first and cannot answer the second, so a well-known global is read
    // ahead of it -- the shape the Erlang side has always had, where the
    // process dictionary comes before `os:getenv`.
    <> "const slot = Symbol.for(\"gleam-mutants.active\");\n"
    <> "export function active() {\n"
    <> "  const local = globalThis[slot];\n"
    <> "  if (typeof local === \"string\") return local;\n"
    <> "  try { if (globalThis.Deno?.env) return globalThis.Deno.env.get(\"GLEAM_MUTANTS_ACTIVE\") ?? \"\"; } catch (_) {}\n"
    <> "  return globalThis.process?.env?.GLEAM_MUTANTS_ACTIVE ?? \"\";\n"
    <> "}\n\n"
    <> "const context = Symbol.for(\"gleam-mutants.test-context\");\n"
    <> "const impacts = Symbol.for(\"gleam-mutants.test-impact\");\n"
    <> "export function record(id) {\n"
    <> "  let enabled = false;\n"
    <> "  try { enabled = Boolean(globalThis.Deno?.env?.get(\"GLEAM_MUTANTS_TEST_IMPACT_FILE\")); } catch (_) {}\n"
    <> "  enabled ||= Boolean(globalThis.process?.env?.GLEAM_MUTANTS_TEST_IMPACT_FILE);\n"
    <> "  if (!enabled) return;\n"
    <> "  const test = globalThis[context];\n"
    <> "  if (typeof test !== \"string\" || test.length === 0) return;\n"
    <> "  const table = globalThis[impacts] ??= new Map();\n"
    <> "  const reached = table.get(test) ?? new Set();\n"
    <> "  reached.add(id); table.set(test, reached);\n"
    <> "}\n\n"
    // Written straight to disk rather than gathered up, because there is no
    // end of the suite to gather at: the test command is whatever the project
    // says it is, and a process a test started has nowhere to hand a table
    // back to. That is also what makes this evidence available to a project
    // whose runner reports no test impact at all.
    //
    // A name is written once per process per answer and remembered only when
    // the write landed, so a site in a loop costs a lookup after the first
    // time round, and a write that failed is tried again rather than passing
    // for an answer. Silence is read as no evidence, never as agreement.
    <> "const observed = Symbol.for(\"gleam-mutants.observed\");\n"
    <> "export function observe(id, differed) {\n"
    <> "  let directory = \"\";\n"
    <> "  try { directory = globalThis.Deno?.env?.get(\"GLEAM_MUTANTS_OBSERVED_DIR\") ?? \"\"; } catch (_) {}\n"
    <> "  directory ||= globalThis.process?.env?.GLEAM_MUTANTS_OBSERVED_DIR ?? \"\";\n"
    <> "  if (!directory) return;\n"
    <> "  const name = (differed ? \"differing/\" : \"same/\") + id;\n"
    <> "  const table = globalThis[observed] ??= new Set();\n"
    <> "  if (table.has(name)) return;\n"
    <> "  try {\n"
    <> "    fs.writeFileSync(directory + \"/\" + name, \"\");\n"
    <> "    table.add(name);\n"
    <> "  } catch (_) {}\n"
    <> "}\n"
  let erlang_source =
    "%% Generated by gleam-mutants.\n-module("
    <> ffi_name
    <> ").\n-export([active/0, record/1, observe/2]).\n"
    <> "active() ->\n"
    <> "    case erlang:get(gleam_mutants_active) of\n"
    <> "        Id when is_binary(Id) -> Id;\n"
    <> "        _ ->\n"
    <> "            case persistent_term:get({gleam_mutants, active}, undefined) of\n"
    <> "                Id when is_binary(Id) -> Id;\n"
    <> "                _ -> from_environment()\n"
    <> "            end\n"
    <> "    end.\n\n"
    <> "from_environment() -> case os:getenv(\"GLEAM_MUTANTS_ACTIVE\") of false -> <<>>; V -> unicode:characters_to_binary(V) end.\n\n"
    <> "record(Id) ->\n"
    <> "    case os:getenv(\"GLEAM_MUTANTS_TEST_IMPACT_FILE\") of\n"
    <> "        false -> nil;\n"
    <> "        _ -> case test_context() of\n"
    <> "            undefined -> nil;\n"
    <> "            TestId -> ensure_impact_table(), ets:insert(gleam_mutants_test_impact, {{TestId, Id}}), nil\n"
    <> "        end\n"
    <> "    end.\n\n"
    <> "test_context() ->\n"
    <> "    case erlang:get(gleam_mutants_test_context) of\n"
    <> "        Id when is_binary(Id) -> Id;\n"
    <> "        _ -> undefined\n"
    <> "    end.\n\n"
    <> "observe(Id, Differed) ->\n"
    <> "    case os:getenv(\"GLEAM_MUTANTS_OBSERVED_DIR\") of\n"
    <> "        false -> nil;\n"
    <> "        Dir ->\n"
    <> "            Name = case Differed of true -> \"differing/\"; _ -> \"same/\" end ++ binary_to_list(Id),\n"
    <> "            ensure_observed_table(),\n"
    <> "            case ets:member(gleam_mutants_observed, Name) of\n"
    <> "                true -> nil;\n"
    <> "                false ->\n"
    <> "                    case file:write_file(filename:join(Dir, Name), <<>>) of\n"
    <> "                        ok -> ets:insert(gleam_mutants_observed, {Name}), nil;\n"
    <> "                        _ -> nil\n"
    <> "                    end\n"
    <> "            end\n"
    <> "    end.\n\n"
    <> "ensure_observed_table() ->\n"
    <> "    case ets:whereis(gleam_mutants_observed) of\n"
    <> "        undefined -> try ets:new(gleam_mutants_observed, [named_table, public, set]) of _ -> ok catch error:badarg -> ok end;\n"
    <> "        _ -> ok\n"
    <> "    end.\n\n"
    <> "ensure_impact_table() ->\n"
    <> "    case ets:whereis(gleam_mutants_test_impact) of\n"
    <> "        undefined -> try ets:new(gleam_mutants_test_impact, [named_table, public, set]) of _ -> ok catch error:badarg -> ok end;\n"
    <> "        _ -> ok\n"
    <> "    end.\n"
  use _ <- result.try(
    simplifile.write(gleam_path, gleam_source)
    |> result.map_error(simplifile.describe_error),
  )
  use _ <- result.try(
    simplifile.write(js_path, js_source)
    |> result.map_error(simplifile.describe_error),
  )
  use _ <- result.try(
    simplifile.write(erlang_path, erlang_source)
    |> result.map_error(simplifile.describe_error),
  )
  Ok(RuntimeModule(module_name, tag))
}
